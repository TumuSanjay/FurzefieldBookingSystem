    \cf2 public \cf4 String \cf6 changeBooking\cf4 (String bookingId, String newLessonId) \{\
        Booking booking = findBookingById(bookingId);\
        \cf2 if \cf4 (booking == \cf2 null\cf4 ) \{\
            \cf2 return \cf8 "Booking not found."\cf4 ;\
