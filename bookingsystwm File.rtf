\
        \cf2 if \cf4 (booking.getStatus().equalsIgnoreCase(\cf8 "cancelled"\cf4 )) \{\
            \cf2 return \cf8 "Cannot change a cancelled booking."\cf4 ;\
        \}\
\
        \cf2 if \cf4 (booking.getStatus().equalsIgnoreCase(\cf8 "attended"\cf4 )) \{\
            \cf2 return \cf8 "Cannot change an attended booking."\cf4 ;\
        \}\
\
        Lesson oldLesson = booking.getLesson();\
        Lesson newLesson = findLessonById(newLessonId);\
\
        \cf2 if \cf4 (newLesson == \cf2 null\cf4 ) \{\
            \cf2 return \cf8 "New lesson not found."\cf4 ;\
        \}\
\
        \cf2 if \cf4 (newLesson.isFull()) \{\
            \cf2 return \cf8 "Change failed. New lesson is full."\cf4 ;\
        \}\
\
        \cf2 for \cf4 (Booking otherBooking : \cf5 bookings\cf4 ) \{\
            \cf2 if \cf4 (otherBooking.getMember().getMemberId().equalsIgnoreCase(booking.getMember().getMemberId()) &&\
                    !otherBooking.getBookingId().equalsIgnoreCase(bookingId) &&\
                    !otherBooking.getStatus().equalsIgnoreCase(\cf8 "cancelled"\cf4 )) \{\
\
                Lesson existingLesson = otherBooking.getLesson();\
\
                \cf2 if \cf4 (existingLesson.getMonth().equalsIgnoreCase(newLesson.getMonth()) &&\
                        existingLesson.getDay().equalsIgnoreCase(newLesson.getDay()) &&\
                        existingLesson.getTimeSlot().equalsIgnoreCase(newLesson.getTimeSlot())) \{\
                    \cf2 return \cf8 "Time conflict. Change not allowed."\cf4 ;\
                \}\
            \}\
        \}\
\
        oldLesson.removeMember(booking.getMember());\
        \cf2 boolean \cf4 added = newLesson.addMember(booking.getMember());\
\
        \cf2 if \cf4 (!added) \{\
            oldLesson.addMember(booking.getMember());\
            \cf2 return \cf8 "Change failed."\cf4 ;\
        \}\
\
        booking.setLesson(newLesson);\
        booking.setStatus(\cf8 "changed"\cf4 );\
